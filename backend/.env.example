# Backend environment variables
# Copy this file to .env and fill in your values

# ── Required ──────────────────────────────────────────────────────────────────
# Get a free key at https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here

# ── Optional ──────────────────────────────────────────────────────────────────
# Raises GitHub API rate limit from 60 → 5000 requests/hour
# Get a token at https://github.com/settings/tokens (no special scopes needed)
GITHUB_TOKEN=ghp_your_github_token_here

# Override the Groq model (default: llama3-8b-8192)
# Options: llama3-70b-8192 | llama-3.3-70b-versatile | mixtral-8x7b-32768 | gemma2-9b-it
GROQ_MODEL=llama-3.1-8b-instant

# Production React URL for CORS (leave blank for local dev)
FRONTEND_URL=
